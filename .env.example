# Backend API base URL (proxied to localhost:5000 in dev via vite.config.js)
VITE_API_URL=/api

# OTP endpoints used: POST /api/register, POST /api/verify-otp, POST /api/resend-otp
# Location endpoint: POST /api/location/update

# Socket.IO server URL (leave empty to use same origin)
VITE_SOCKET_URL=

# OpenRouteService API Configuration (for routing and distance/time calculation)
VITE_ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6IjA3NGFkZjc2MzdjOTQzZGU4YTg2NjIwODMyNzY0YTdmIiwiaCI6Im11cm11cjY0In0=
VITE_ORS_API_URL=https://api.openrouteservice.org

# Map Configuration (Chennai, India by default)
VITE_DEFAULT_CENTER_LAT=13.0827
VITE_DEFAULT_CENTER_LNG=80.2707
VITE_DEFAULT_ZOOM=14

# Legacy: Google Maps (deprecated, will be replaced by OpenStreetMap)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
