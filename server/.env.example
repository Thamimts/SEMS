# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/sems
MONGODB_TEST_URI=mongodb://localhost:27017/sems-test

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Socket.IO
SOCKETIO_RECONNECT_DELAY=1000
SOCKETIO_RECONNECT_DELAY_MAX=5000

# CORS
CORS_ORIGIN=http://localhost:3000

# Location Settings
LOCATION_UPDATE_INTERVAL=2000
NEARBY_VEHICLE_RADIUS=20

# Emergency Settings
EMERGENCY_EXPIRY_HOURS=24
GREEN_CORRIDOR_DURATION=300

# Hospital Settings
HOSPITAL_VERIFICATION_TIMEOUT=30000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Features
ENABLE_V2X=true
ENABLE_TRAFFIC_OVERRIDE=true
ENABLE_LOCATION_HISTORY=true
